  "nodes": [
    {
      "id": "vpc1",
      "type": "aws.vpc",
      "position": {
        "x": 0,
        "y": 0
      },
      "size": {
        "w": 848,
        "h": 584
      },
      "properties": {
        "name": "main",
        "cidr": "10.20.0.0/16",
        "nat": "single"
      }
    },
    {
      "id": "alb1",
      "type": "aws.alb",
      "parentId": "vpc1-public-a",
      "position": {
        "x": 24,
        "y": 38
      },
      "properties": {
        "name": "web",
        "internal": false,
        "https": false,
        "idleTimeout": 60
      }
    },
    {
      "id": "svc1",
      "type": "aws.ecs_fargate",
      "parentId": "vpc1-private-a",
      "position": {
        "x": 24,
        "y": 38
      },
      "properties": {
        "name": "api",
        "image": "public.ecr.aws/nginx/nginx:stable",
        "containerPort": 8080,
        "cpu": 512,
        "memory": 1024,
        "desiredCount": 2,
        "healthCheckPath": "/health",
        "user": "1000:1000",
        "readonlyRoot": true
      }
    },
    {
      "id": "db1",
