{
  "schemaVersion": "1.0.0",
  "project": {
    "name": "sink",
    "squad": "platform",
    "environment": "dev",
    "region": "us-east-1"
  },
  "nodes": [
    {
      "id": "vpc1",
      "type": "aws.vpc",
      "position": {
        "x": 0,
        "y": 0
      },
      "size": {
        "w": 1264,
        "h": 584
      },
      "properties": {
        "name": "main",
        "cidr": "10.30.0.0/16",
        "nat": "per-az"
      }
    },
    {
      "id": "alb1",
      "type": "aws.alb",
      "parentId": "vpc1-public-a",
      "position": {
        "x": 24,
        "y": 38
      },
      "properties": {
        "name": "web",
        "internal": false,
        "https": true,
        "idleTimeout": 60
      }
    },
    {
      "id": "svc1",
      "type": "aws.ecs_fargate",
      "parentId": "vpc1-private-a",
      "position": {
        "x": 24,
        "y": 38
      },
      "properties": {
        "name": "api",
        "image": "public.ecr.aws/nginx/nginx:stable",
        "containerPort": 8080,
        "cpu": 512,
        "memory": 1024,
        "desiredCount": 2,
        "healthCheckPath": "/health"
      }
    },
    {
      "id": "db1",
      "type": "aws.rds_postgres",
      "parentId": "vpc1-database-a",
      "position": {
        "x": 24,
        "y": 38
      },
      "properties": {
        "name": "db",
        "engineVersion": "16.4",
        "instanceClass": "db.t4g.medium",
        "storage": 50,
        "dbName": "app",
        "multiAz": true,
        "backupDays": 7
      }
    },
    {
      "id": "acm1",
      "type": "aws.acm",
      "position": {
        "x": 0,
        "y": 700
      },
      "properties": {
        "name": "cert",
        "domainName": "app.example.gov.sg",
        "hostedZone": ""
      }
    },
    {
      "id": "cf1",
      "type": "aws.cloudfront",
      "position": {
        "x": 200,
        "y": 700
      },
      "properties": {
        "name": "cdn",
        "priceClass": "PriceClass_200",
        "rootObject": "index.html"
      }
    },
    {
      "id": "cf2",
      "type": "aws.cloudfront",
      "position": {
        "x": 400,
        "y": 700
      },
      "properties": {
        "name": "static",
        "priceClass": "PriceClass_100",
        "rootObject": "index.html"
      }
    },
    {
      "id": "s31",
      "type": "aws.s3",
      "position": {
        "x": 600,
        "y": 700
      },
      "properties": {
        "name": "assets",
        "versioning": true,
        "forceDestroy": false
      }
    },
    {
      "id": "s32",
      "type": "aws.s3",
      "position": {
        "x": 800,
        "y": 700
      },
      "properties": {
        "name": "site",
        "versioning": false,
        "forceDestroy": true
      }
    },
    {
      "id": "ddb1",
      "type": "aws.dynamodb",
      "position": {
        "x": 0,
        "y": 900
      },
      "properties": {
        "name": "items",
        "hashKey": "id",
        "hashKeyType": "S",
        "billing": "PAY_PER_REQUEST"
      }
    },
    {
      "id": "q1",
      "type": "aws.sqs",
      "position": {
        "x": 200,
        "y": 900
      },
      "properties": {
        "name": "jobs",
        "fifo": false,
        "visibility": 30,
        "dlq": true
      }
    },
    {
      "id": "t1",
      "type": "aws.sns",
      "position": {
        "x": 400,
        "y": 900
      },
      "properties": {
        "name": "events",
        "fifo": false
      }
    },
    {
      "id": "fn1",
      "type": "aws.lambda",
      "position": {
        "x": 600,
        "y": 900
      },
      "properties": {
        "name": "worker",
        "runtime": "nodejs20.x",
        "handler": "index.handler",
        "sourcePath": "./src/handler",
        "memory": 256,
        "timeout": 10
      }
    },
    {
      "id": "gw1",
      "type": "aws.apigw",
      "position": {
        "x": 800,
        "y": 900
      },
      "properties": {
        "name": "api-gw",
        "route": "ANY /{proxy+}"
      }
    },
